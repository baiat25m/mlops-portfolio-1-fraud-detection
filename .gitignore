# Python
__pycache__/
*.py[oc]
*.egg-info/
build/
dist/

# Environments and secrets: never commit these
.venv/
.env
.env.*
!.env.example

# Tool caches
.pytest_cache/
.ruff_cache/
.coverage

# Data, models and generated reports are not committed.
# The leading / means "only at the repo root": without it, data/ would also
# ignore the source package src/fraud_detection/data/.
/reports/
/mlruns/
/data/
/models/
*.joblib
*.pkl
*.parquet

# OS
.DS_Store
